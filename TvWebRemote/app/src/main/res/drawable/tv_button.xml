<?xml version="1.0" encoding="utf-8"?>
<!-- Big, obvious focus state so you can always see where the remote is pointing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raised" />
            <stroke android:width="4dp" android:color="@color/focus" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/raised" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/raised" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
